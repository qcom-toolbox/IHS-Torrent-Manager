# Template unit file -- install.sh substitutes __APP_DIR__, __DATA_DIR__,
# __DOWNLOAD_DIR__, __CONFIG_DIR__ and __SERVICE_USER__ for the paths/user
# chosen during installation, then writes the result to
# /etc/systemd/system/ihs-torrent-manager.service.
[Unit]
Description=IHS Torrent Manager - Management Panel
Documentation=https://github.com/qcom-toolbox/IHS-Torrent-Manager
After=network-online.target qbittorrent-nox.service
Wants=network-online.target
Requires=ihs-torrent-manager-worker.service

[Service]
Type=simple
User=__SERVICE_USER__
Group=__SERVICE_USER__
WorkingDirectory=__APP_DIR__
EnvironmentFile=__CONFIG_DIR__/app.env
ExecStart=/usr/bin/node __APP_DIR__/app/dist/index.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=20

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=__DATA_DIR__ __DOWNLOAD_DIR__
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true

StandardOutput=journal
StandardError=journal
SyslogIdentifier=ihs-torrent-manager

[Install]
WantedBy=multi-user.target
