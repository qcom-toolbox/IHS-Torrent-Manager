<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Watch</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="wrap watch-wrap">
    <div class="top-bar">
      <a href="/" class="logout">&larr; Back to downloads</a>
      <form method="POST" action="/logout">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" class="logout logout-btn">Sign out</button>
      </form>
    </div>
    <div class="card watch-card">
      <div class="name watch-title"><%= name %></div>
      <video
        id="player"
        class="player"
        controls
        playsinline
        preload="metadata"
        data-stream-url="<%= streamUrl %>"
        data-default-track="<%= defaultAudioIndex === null ? '' : defaultAudioIndex %>"
      >
        <source src="<%= streamUrl %>" type="<%= mimeType %>">
      </video>
      <% if (tracks.length > 1) { %>
        <div id="audio-track-row" class="audio-track-row">
          <label for="audio-track-select">Audio track</label>
          <select id="audio-track-select">
            <% tracks.forEach(function(t) { %>
              <option value="<%= t.audioIndex %>" <%= t.audioIndex === defaultAudioIndex ? 'selected' : '' %>><%= t.label %></option>
            <% }); %>
          </select>
        </div>
      <% } %>
      <div class="meta watch-hint">
        Video is always decoded in your browser (hardware-accelerated where your
        device/browser supports it) -- this server never re-encodes it. Switching
        audio tracks reloads the stream with that track selected (a brief pause,
        then playback resumes near where you left off).
      </div>
    </div>
  </div>
  <script src="/watch.js"></script>
</body>
</html>
