<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Completed Downloads</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="wrap">
    <div class="top-bar">
      <h1 class="top-bar-title">Completed Downloads</h1>
      <form method="POST" action="/logout">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" class="logout logout-btn">Sign out</button>
      </form>
    </div>
    <div class="card">
      <% if (torrents.length === 0) { %>
        <div class="empty">No completed downloads yet.</div>
      <% } else { %>
        <ul class="list">
          <% torrents.forEach(function(t) { %>
            <li class="item torrent-item">
              <div class="item-row">
                <div>
                  <div class="name"><%= t.name %></div>
                  <div class="meta"><%= t.sizeFormatted %> &middot; Completed: <%= t.completedAtFormatted %></div>
                </div>
                <% if (t.files.length > 1) { %>
                  <form method="POST" action="/create-download-link/<%= t.id %>">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <button type="submit" class="dl-btn">Download all (.zip)</button>
                  </form>
                <% } %>
              </div>
              <% if (t.files.length > 0) { %>
                <ul class="file-list">
                  <% t.files.forEach(function(f) { %>
                    <li class="file-row">
                      <div class="file-name"><%= f.name %> <span class="meta">(<%= f.sizeFormatted %>)</span></div>
                      <div class="file-actions">
                        <% if (f.isVideo) { %>
                          <form method="POST" action="/create-watch-link/<%= t.id %>/<%= f.index %>">
                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                            <button type="submit" class="watch-btn">Watch</button>
                          </form>
                        <% } %>
                        <form method="POST" action="/create-download-link/<%= t.id %>/<%= f.index %>">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                          <button type="submit" class="dl-btn file-dl-btn">Download</button>
                        </form>
                      </div>
                    </li>
                  <% }); %>
                </ul>
              <% } %>
            </li>
          <% }); %>
        </ul>
      <% } %>
    </div>
  </div>
</body>
</html>
