{
  "name": "@torrent-manager/portal",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run copy-assets",
    "copy-assets": "mkdir -p dist/views dist/public && cp -r src/views/* dist/views/ && cp -r src/public/* dist/public/",
    "dev": "tsc -p tsconfig.json --watch",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@torrent-manager/shared": "1.0.0",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "helmet": "^7.1.0",
    "ejs": "^3.1.10",
    "express-rate-limit": "^7.4.0",
    "archiver": "^7.0.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/node": "^20.14.15",
    "@types/archiver": "^6.0.2",
    "typescript": "^5.5.4"
  }
}
