# Example environment configuration for local development.
#
# In production, install.sh generates three SEPARATE env files instead of
# one shared file (see /etc/torrent-manager/*.env after installation):
#   app.env    - management panel (needs qBittorrent credentials)
#   worker.env - sync worker (needs qBittorrent credentials)
#   portal.env - download portal (deliberately does NOT get qBittorrent
#                credentials -- it only ever reads the database and the
#                torrent download directory)
#
# Never commit a real .env file. This file only documents the variables.

NODE_ENV=development

# ---- Shared by all services ----
DATABASE_PATH=./data/torrent-manager.sqlite
TORRENT_DOWNLOAD_DIR=./data/torrents

# Disk space warning thresholds (percent FREE space remaining)
DISK_WARNING_THRESHOLD_PERCENT_FREE=20
DISK_CRITICAL_THRESHOLD_PERCENT_FREE=10
DISK_BLOCK_THRESHOLD_PERCENT_FREE=5

# ---- Management panel (app) ----
APP_PORT=3000
APP_HOST=127.0.0.1
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-value
# Set to true once the app is served over HTTPS (directly or via reverse proxy)
COOKIE_SECURE=false
# Set to true when running behind nginx/Caddy so req.ip / secure cookies work correctly
TRUST_PROXY=false
MAX_UPLOAD_SIZE_BYTES=10485760

# ---- qBittorrent Web API (used by app + worker only, NEVER the portal) ----
TORRENT_HOST=http://127.0.0.1:8080
TORRENT_USERNAME=admin
TORRENT_PASSWORD=change-me

# ---- Background sync worker ----
WORKER_SYNC_INTERVAL_MS=5000

# ---- Download portal ----
PORTAL_PORT=3001
PORTAL_HOST=127.0.0.1
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
PORTAL_SESSION_SECRET=change-me-to-a-different-long-random-value

# The portal's actual login password is stored (Argon2id-hashed) in the
# database `settings` table under key `portal_password_hash`, set during
# install or from Settings in the management panel -- not as an env var.
